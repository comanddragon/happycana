# Browser-facing API endpoint. NEXT_PUBLIC_* values are shipped to browsers.
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
NEXT_PUBLIC_FRONTEND_URL=https://shop.example.com
NEXT_PUBLIC_STOREFRONT_NAME=Store Name
NEXT_PUBLIC_STOREFRONT_DESCRIPTION=Your storefront description.
# Optional fallback for scripts/build contexts that have no incoming hostname.
NEXT_PUBLIC_STOREFRONT_SLUG=

# Server-only API endpoints used by Next.js SSR/ISR and rewrites.
API_URL=https://api.example.com/api
BACKEND_ORIGIN=https://api.example.com

# Optional integrations
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SMARTSUPP_KEY=
